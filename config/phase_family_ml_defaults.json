{
  "random_seed": 17,
  "dataset": {
    "input_csv": "results/processed/merged_interval_dataset.csv",
    "output_dir": "results/phase_family_ml",
    "horizon": 20,
    "history_length": 16
  },
  "families": {
    "threshold_mode": "global",
    "names": ["L1", "L2", "LLC", "memory_offcore", "branch_control", "core_fp"]
  },
  "splits": {
    "train_fraction": 0.7,
    "val_fraction": 0.15,
    "test_fraction": 0.15
  },
  "ablation": {
    "score_weights": {
      "accuracy": 0.4,
      "phase_change_f1": 0.4,
      "high_usage_recall": 0.2
    },
    "tree_max_depth": 5,
    "tree_min_samples_leaf": 3,
    "global_exhaustive_one_per_family": true
  },
  "teacher": {
    "epochs": 4,
    "batch_size": 256,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "hidden_dim": 128,
    "num_layers": 4,
    "num_heads": 4,
    "ff_dim": 256,
    "dropout": 0.1,
    "rope_theta": 10000.0,
    "context_modes": ["without_context", "with_context"]
  },
  "student": {
    "blend_alpha": 0.25,
    "decision_tree_max_depth": 6,
    "decision_tree_min_samples_leaf": 8,
    "run_length_buckets": [1, 3, 7, 15]
  },
  "experiments": {
    "modes": ["pooled_run_group"],
    "default_mode": "pooled_run_group"
  },
  "runtime": {
    "profile": "quick",
    "quick": {"teacher_epochs": 2},
    "full": {"teacher_epochs": 8}
  }
}
